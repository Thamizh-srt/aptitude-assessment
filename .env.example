# Copy this file to .env at the repository root and replace development placeholders.
# Replace the placeholders with credentials and a cluster from MongoDB Atlas.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aptitude_assessment?retryWrites=true&w=majority"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
# Configure both values to enable candidate email verification.
BREVO_API_KEY=
MAIL_FROM=
NODE_ENV="development"
