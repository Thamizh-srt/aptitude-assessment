# Replace the placeholders with credentials and a cluster from MongoDB Atlas.
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aptitude_assessment?retryWrites=true&w=majority"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123"
# Configure all mail settings to enable candidate email verification.
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Aptitude Assessment"
NODE_ENV="development"
